<?xml version="1.0" ?>
<!--
  Копия шаблона PSL1GHT ($PS3DEV/bin/sfo.xml) с одним отличием: CATEGORY = CB
  вместо HG.

  На консолях с folder-XMB (папки «Программы», «Retro», «PlayStation®3»)
  папка PS3-игр собирается запросом «все CATEGORY = HG минус чёрный список
  Title ID», а папки «Программ» — белыми списками. Приложение с HG попадает
  к играм, и убрать его оттуда правкой чёрного списка нельзя: лишнее условие
  в этом запросе вешает консоль намертво (см. docs/INSTALL.md). С CB оно туда
  просто не отбирается, а в белые списки проходит — так живёт PKGi.

  На стоковом XMB CB — это колонка «Сеть». Приложение отчитывается по сети,
  так что место не случайное.
-->
<sfo>
	<value name="APP_VER" type="string">
		01.00
	</value>
	<value name="ATTRIBUTE" type="integer">
		0
	</value>
	<value name="BOOTABLE" type="integer">
		1
	</value>
	<value name="CATEGORY" type="string">
		CB
	</value>
	<value name="LICENSE" type="string">
		This application was created with the official non-official SDK called psl1ght, for more information visit http://www.psl1ght.com/ . This is in no way associated with Sony Computer Entertainment Inc., please do not contact them for help, they will not be able to provide it.
	</value>
	<value name="PARENTAL_LEVEL" type="integer">
		0
	</value>
	<value name="PS3_SYSTEM_VER" type="string">
		01.8000
	</value>
	<value name="RESOLUTION" type="integer">
		63
	</value>
	<value name="SOUND_FORMAT" type="integer">
		279
	</value>
	<value name="TITLE" type="string">
		Test - PSL1GHT
	</value>
	<value name="TITLE_ID" type="string">
		TEST00000
	</value>
	<value name="VERSION" type="string">
		01.00
	</value>
</sfo>
