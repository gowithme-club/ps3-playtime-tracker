# Артефакты сборки
objs/
build/
*.o
*.a
*.elf
*.prx
*.sprx
*.self
*.sym
*.pkg

# Проприетарное и большое — в репозиторий не попадает никогда.
# Cell SDK подключается через $CELL_SDK, тулчейн — через $PS3DEV.
/sdk/
/cell/
/ps3dev/

# Локальные конфиги с токеном
gwm.cfg
.DS_Store

# Подписывающие утилиты и ключи — тянутся скриптом, не коммитятся
/vendor/

# Собранные версии
/dist/

# Ссылка на ключи, создаётся при подписи
plugin/data

# Сборка приложения
/app/build/
/app/*.elf
/app/*.pkg

# Пробники (probe, hello, udp) собираются в свои каталоги, чтобы не затирать
# .elf приложения — см. цели probe/hello/udp в app/Makefile
/app/build-*/

# Локальные заметки агентов; общие инструкции — в AGENTS.md
CLAUDE.md
